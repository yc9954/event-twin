# Copy to .env locally. Never commit real API keys.
# Choose openai, nvidia, nim, or anthropic explicitly.
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=
# Exact tool-calling model ID from build.nvidia.com; intentionally unset.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Self-hosted NIM: expose through an SSH tunnel or authenticated HTTPS.
NIM_BASE_URL=
NIM_MODEL=
NIM_API_KEY=
# NGC registry entitlement (not a hosted API credential).
NGC_API_KEY=
# Existing OpenAI route remains available when explicitly selected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Optional NVIDIA/NIM -> Claude fallback. Requires renewed browser consent.
# Leave MODEL_FALLBACK_PROVIDER empty to disable. Keys never go in Vercel/browser.
MODEL_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=4180
