# Copy to .env locally. Never commit real API keys.
# No provider fallback. Choose openai, nvidia, or nim explicitly.
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=
# Exact tool-calling model ID from build.nvidia.com; intentionally unset.
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Self-hosted NIM: expose through an SSH tunnel or authenticated HTTPS.
NIM_BASE_URL=
NIM_MODEL=
NIM_API_KEY=
# NGC registry entitlement (not a hosted API credential).
NGC_API_KEY=
# Existing OpenAI route remains available when explicitly selected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
PORT=4180
